{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "HashMeterAi locked capability set. Read-only filesystem via Rust std::fs (not the fs plugin). Only store, dialog, and opener plugins are exposed.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "window-state:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "store:allow-delete",
    "dialog:default",
    "dialog:allow-save",
    "opener:default"
  ]
}
